{
  "openapi": "3.1.0",
  "info": {
    "title": "StockMock Indian F&O Terminal API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/instruments": {
      "get": {
        "summary": "List Instruments",
        "operationId": "list_instruments_api_v1_market_instruments_get",
        "parameters": [
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstrumentSpecSchema"
                  },
                  "title": "Response List Instruments Api V1 Market Instruments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/chain": {
      "get": {
        "summary": "Get Option Chain",
        "operationId": "get_option_chain_api_v1_market_chain_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "NIFTY",
                "BANKNIFTY",
                "FINNIFTY",
                "SENSEX"
              ],
              "type": "string",
              "default": "NIFTY",
              "title": "Symbol"
            }
          },
          {
            "name": "expiry",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Expiry"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionChainSnapshotSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/evaluate": {
      "post": {
        "summary": "Evaluate Strategy Payoff",
        "operationId": "evaluate_strategy_payoff_api_v1_analytics_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayoffEvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoffEvaluateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market/quotes-schema": {
      "get": {
        "summary": " Quotes Schema Placeholder",
        "operationId": "_quotes_schema_placeholder_api_v1_market_quotes_schema_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/LegQuoteSchema"
                  },
                  "type": "object",
                  "title": "Response  Quotes Schema Placeholder Api V1 Market Quotes Schema Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/preview-schema": {
      "post": {
        "summary": " Orders Schema Placeholder",
        "operationId": "_orders_schema_placeholder_api_v1_orders_preview_schema_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionResultSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/strategies": {
      "get": {
        "summary": "List Strategies Placeholder",
        "operationId": "list_strategies_placeholder_api_v1_strategies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StrategyResponse"
                  },
                  "type": "array",
                  "title": "Response List Strategies Placeholder Api V1 Strategies Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchOrderRequest": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "title": "Idempotency Key"
          },
          "strategy_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy Id"
          },
          "parent_order_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Order Id"
          },
          "trading_mode": {
            "type": "string",
            "enum": [
              "SIMULATOR",
              "PAPER",
              "SANDBOX",
              "LIVE"
            ],
            "title": "Trading Mode",
            "default": "SIMULATOR"
          },
          "slice_if_frozen": {
            "type": "boolean",
            "title": "Slice If Frozen",
            "default": true
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/OrderLegInstruction"
            },
            "type": "array",
            "title": "Legs"
          }
        },
        "type": "object",
        "required": [
          "idempotency_key",
          "legs"
        ],
        "title": "BatchOrderRequest"
      },
      "ExecutionResultSchema": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "title": "Idempotency Key"
          },
          "deduplicated": {
            "type": "boolean",
            "title": "Deduplicated",
            "default": false
          },
          "trading_mode": {
            "type": "string",
