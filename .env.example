# PostgreSQL
POSTGRES_USER=stockmock
POSTGRES_PASSWORD=stockmock_dev
POSTGRES_DB=stockmock
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://stockmock:stockmock_dev@localhost:5434/stockmock

# Trading Safety Guard
TRADING_MODE=SIMULATOR
KILL_SWITCH_ENGAGED=false

# Quant Defaults
DEFAULT_RISK_FREE_RATE=0.0
INCLUDE_CHARGES_DEFAULT=false

# Mock market streaming defaults
MOCK_LIVE_JITTER=false
WS_TICK_INTERVAL_MS=250

# Historical Parquet Cache & DhanHQ v2 Credentials (Phase 2+)
PARQUET_DATA_DIR=../data/parquet
SCRIP_MASTER_CACHE_PATH=../data/cache/dhan_scrip_master.csv
MARKET_DATA_SOURCE=auto
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/stream

